# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PAYMONGO_SECRET_KEY: Required for PayMongo API payment processing (e.g., sk_test_... or sk_live_...).
# Users configure this via the Secrets panel in AI Studio UI or .env file.
PAYMONGO_SECRET_KEY=

# PAYMONGO_PUBLIC_KEY: Public key for client-side PayMongo integration (e.g., pk_test_... or pk_live_...).
PAYMONGO_PUBLIC_KEY=
